enable-pre-post-scripts=true

# Autorise les scripts de build pour Prisma
approve-builds[]=@prisma/client
approve-builds[]=@prisma/engines
approve-builds[]=prisma

# Hoist auth packages pour que TypeScript resolve leurs chemins sans hash pnpm
public-hoist-pattern[]=@auth/core
public-hoist-pattern[]=next-auth

# Hoist Prisma pour que le client généré soit accessible à Next.js
public-hoist-pattern[]=@prisma/client
public-hoist-pattern[]=.prisma
