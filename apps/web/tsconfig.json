{
  "extends": "@warforge/config/typescript/nextjs",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@auth/core": ["../../node_modules/@auth/core"],
      "@auth/core/*": ["../../node_modules/@auth/core/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
