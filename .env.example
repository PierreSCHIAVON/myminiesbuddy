# ── Base de données Warforge ──────────────────────────────────
DATABASE_URL="postgresql://warforge:warforge_dev@localhost:5435/warforge_dev"

# ── Keycloak SSO ──────────────────────────────────────────────
KEYCLOAK_ISSUER="http://localhost:8090/realms/warforge"
KEYCLOAK_CLIENT_ID="warforge-web"
KEYCLOAK_CLIENT_SECRET="changeme-generate-in-keycloak"

# ── Auth.js ───────────────────────────────────────────────────
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
