generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Le .env est lu depuis la racine du monorepo via turbo
}

// ─────────────────────────────────────────────────────────────
// UTILISATEURS (synchronisés depuis Keycloak au premier login)
// ─────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  // sub = identifiant unique Keycloak (ex: "a3f2c1d0-...")
  keycloakId  String   @unique
  email       String   @unique
  name        String?
  image       String?
  role        UserRole @default(PLAYER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizedTournaments Tournament[]       @relation("Organizer")
  participations       TournamentPlayer[]
  notifications        Notification[]
}

enum UserRole {
  PLAYER      // joueur standard
  ORGANIZER   // peut créer des tournois
  ADMIN       // accès complet
}

// ─────────────────────────────────────────────────────────────
// JEUX
// ─────────────────────────────────────────────────────────────

model Game {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique  // ex: "warhammer-40k", "age-of-sigmar"
  abbreviation String?           // ex: "W40K", "WAoS", "BB"
  description  String?
  logoUrl      String?
  createdAt    DateTime @default(now())

  tournaments Tournament[]
  factions    Faction[]
}

// ─────────────────────────────────────────────────────────────
// FACTIONS (armées/équipes disponibles par jeu)
// ─────────────────────────────────────────────────────────────

model Faction {
  id      String  @id @default(cuid())
  name    String
  slug    String
  group   String? // ex: "Grand Alliance Chaos", "Imperium", "Xenos"
  logoUrl String?

  gameId  String
  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  players TournamentPlayer[]

  @@unique([gameId, slug])
}

// ─────────────────────────────────────────────────────────────
// TOURNOIS
// ─────────────────────────────────────────────────────────────

model Tournament {
  id          String           @id @default(cuid())
  name        String
  description String?
  slug        String           @unique
  date        DateTime
  location    String?
  maxPlayers  Int              @default(16)
  status      TournamentStatus @default(DRAFT)
  format      TournamentFormat @default(SWISS)
  pointsLimit Int?             // limite de points pour les listes d'armée
  teamSize    Int?             // null = individuel, 3 = 3v3, 4 = 4v4, etc.
  topCutSize  Int?             // null = pas de top-cut, 4/8/16 = bracket d'élimination

  gameId      String
  game        Game   @relation(fields: [gameId], references: [id])

  organizerId String
  organizer   User   @relation("Organizer", fields: [organizerId], references: [id])

  players        TournamentPlayer[]
  rounds         Round[]
  teams          Team[]
  bracketMatches BracketMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TournamentStatus {
  DRAFT        // en préparation
  OPEN         // inscriptions ouvertes
  IN_PROGRESS  // en cours
  COMPLETED    // terminé
  CANCELLED    // annulé
}

enum TournamentFormat {
  SWISS        // appairage suisse (le plus courant)
  ROUND_ROBIN  // tout le monde joue contre tout le monde
  ELIMINATION  // élimination directe
}

// ─────────────────────────────────────────────────────────────
// JOUEURS INSCRITS
// ─────────────────────────────────────────────────────────────

model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  factionId String? // FK vers Faction (null si jeu sans factions structurées)
  factionRef Faction? @relation(fields: [factionId], references: [id])
  listNotes String? // notes sur la liste
  pseudo    String? // nom affiché dans le tournoi (override de user.name)
  teamName  String? // équipe représentée (string libre — Option A)
  teamId    String? // FK vers Team (Option B — tournois par équipes structurées)
  team      Team?   @relation(fields: [teamId], references: [id])

  // Scores cumulés (mis à jour après chaque round)
  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)
  points Int @default(0) // points de victoire
  sos    Int @default(0) // Strength of Schedule (qualité des adversaires)

  registeredAt DateTime @default(now())

  matchesAsPlayer1        Match[]         @relation("Player1")
  matchesAsPlayer2        Match[]         @relation("Player2")
  bracketMatchesAsPlayer1 BracketMatch[]  @relation("BracketPlayer1")
  bracketMatchesAsPlayer2 BracketMatch[]  @relation("BracketPlayer2")

  @@unique([tournamentId, userId])
}

// ─────────────────────────────────────────────────────────────
// RONDES ET MATCHS
// ─────────────────────────────────────────────────────────────

model Round {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int         // numéro de la ronde (1, 2, 3...)
  status       RoundStatus @default(PENDING)

  matches     Match[]
  teamMatches TeamMatch[]

  createdAt DateTime @default(now())

  @@unique([tournamentId, number])
}

enum RoundStatus {
  PENDING     // pas encore commencée
  IN_PROGRESS // en cours
  COMPLETED   // terminée
}

model Match {
  id      String @id @default(cuid())
  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  player1Id String
  player1   TournamentPlayer  @relation("Player1", fields: [player1Id], references: [id])
  player2Id String?           // null = BYE (nombre impair de joueurs)
  player2   TournamentPlayer? @relation("Player2", fields: [player2Id], references: [id])

  player1Score Int?
  player2Score Int?
  winnerId     String? // id du TournamentPlayer gagnant, null = draw

  status MatchStatus @default(PENDING)

  table       Int?       // numéro de table physique
  notes       String?    // notes arbitre
  teamMatchId String?    // FK vers TeamMatch (null = tournoi individuel)
  teamMatch   TeamMatch? @relation(fields: [teamMatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// TOURNOIS PAR ÉQUIPES
// ─────────────────────────────────────────────────────────────

model Team {
  id           String             @id @default(cuid())
  name         String
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players      TournamentPlayer[]
  teamMatches1           TeamMatch[]     @relation("TeamMatch_team1")
  teamMatches2           TeamMatch[]     @relation("TeamMatch_team2")
  bracketMatchesAsTeam1  BracketMatch[]  @relation("BracketTeam1")
  bracketMatchesAsTeam2  BracketMatch[]  @relation("BracketTeam2")

  // Stats équipe (calculées après chaque match d'équipe)
  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)
  points Int @default(0) // wins*3 + draws*1

  createdAt DateTime @default(now())

  @@unique([tournamentId, name])
}

model TeamMatch {
  id      String @id @default(cuid())
  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  team1Id String
  team1   Team   @relation("TeamMatch_team1", fields: [team1Id], references: [id])
  team2Id String? // null = BYE équipe
  team2   Team?  @relation("TeamMatch_team2", fields: [team2Id], references: [id])

  team1TableWins Int         @default(0) // tables remportées par équipe 1
  team2TableWins Int         @default(0)
  winnerId       String?     // teamId du gagnant, null = draw ou en cours
  status         MatchStatus @default(PENDING)

  matches Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MatchStatus {
  PENDING     // pas encore joué
  IN_PROGRESS // en cours
  COMPLETED   // résultat saisi
  BYE         // joueur exempt (adversaire absent ou nombre impair)
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS IN-APP
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?          // URL de destination au clic
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  NEW_REGISTRATION   // organisateur : nouveau joueur inscrit
  TOURNAMENT_START   // joueur : le tournoi démarre
}

// ─────────────────────────────────────────────────────────────
// TOP-CUT / BRACKET D'ÉLIMINATION DIRECTE
// ─────────────────────────────────────────────────────────────

model BracketMatch {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Structure du bracket
  roundOf   Int // 8 = QF, 4 = SF, 2 = Finale — nombre de participants encore en lice
  position  Int // 1-based ; ceil(P/2) = position dans le round suivant

  // Mode individuel
  player1Id String?
  player1   TournamentPlayer? @relation("BracketPlayer1", fields: [player1Id], references: [id])
  player2Id String?
  player2   TournamentPlayer? @relation("BracketPlayer2", fields: [player2Id], references: [id])

  // Mode équipe
  team1Id String?
  team1   Team? @relation("BracketTeam1", fields: [team1Id], references: [id])
  team2Id String?
  team2   Team? @relation("BracketTeam2", fields: [team2Id], references: [id])

  player1Score Int?
  player2Score Int?
  winnerId     String?     // TournamentPlayer.id ou Team.id selon le mode

  status MatchStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, roundOf, position])
}
