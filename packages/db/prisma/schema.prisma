generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Le .env est lu depuis la racine du monorepo via turbo
}

// ─────────────────────────────────────────────────────────────
// UTILISATEURS (synchronisés depuis Keycloak au premier login)
// ─────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  // sub = identifiant unique Keycloak (ex: "a3f2c1d0-...")
  keycloakId  String   @unique
  email       String   @unique
  name        String?
  image       String?
  role        UserRole @default(PLAYER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizedTournaments Tournament[]       @relation("Organizer")
  participations       TournamentPlayer[]
}

enum UserRole {
  PLAYER      // joueur standard
  ORGANIZER   // peut créer des tournois
  ADMIN       // accès complet
}

// ─────────────────────────────────────────────────────────────
// JEUX
// ─────────────────────────────────────────────────────────────

model Game {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique  // ex: "warhammer-40k", "age-of-sigmar"
  abbreviation String?           // ex: "W40K", "WAoS", "BB"
  description  String?
  logoUrl      String?
  createdAt    DateTime @default(now())

  tournaments Tournament[]
  factions    Faction[]
}

// ─────────────────────────────────────────────────────────────
// FACTIONS (armées/équipes disponibles par jeu)
// ─────────────────────────────────────────────────────────────

model Faction {
  id      String  @id @default(cuid())
  name    String
  slug    String
  group   String? // ex: "Grand Alliance Chaos", "Imperium", "Xenos"
  logoUrl String?

  gameId  String
  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  players TournamentPlayer[]

  @@unique([gameId, slug])
}

// ─────────────────────────────────────────────────────────────
// TOURNOIS
// ─────────────────────────────────────────────────────────────

model Tournament {
  id          String           @id @default(cuid())
  name        String
  description String?
  slug        String           @unique
  date        DateTime
  location    String?
  maxPlayers  Int              @default(16)
  status      TournamentStatus @default(DRAFT)
  format      TournamentFormat @default(SWISS)
  pointsLimit Int?             // limite de points pour les listes d'armée

  gameId      String
  game        Game   @relation(fields: [gameId], references: [id])

  organizerId String
  organizer   User   @relation("Organizer", fields: [organizerId], references: [id])

  players TournamentPlayer[]
  rounds  Round[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TournamentStatus {
  DRAFT        // en préparation
  OPEN         // inscriptions ouvertes
  IN_PROGRESS  // en cours
  COMPLETED    // terminé
  CANCELLED    // annulé
}

enum TournamentFormat {
  SWISS        // appairage suisse (le plus courant)
  ROUND_ROBIN  // tout le monde joue contre tout le monde
  ELIMINATION  // élimination directe
}

// ─────────────────────────────────────────────────────────────
// JOUEURS INSCRITS
// ─────────────────────────────────────────────────────────────

model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  factionId String? // FK vers Faction (null si jeu sans factions structurées)
  factionRef Faction? @relation(fields: [factionId], references: [id])
  listNotes String? // notes sur la liste
  pseudo    String? // nom affiché dans le tournoi (override de user.name)
  teamName  String? // équipe représentée (string libre — Option A)

  // Scores cumulés (mis à jour après chaque round)
  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)
  points Int @default(0) // points de victoire
  sos    Int @default(0) // Strength of Schedule (qualité des adversaires)

  registeredAt DateTime @default(now())

  matchesAsPlayer1 Match[] @relation("Player1")
  matchesAsPlayer2 Match[] @relation("Player2")

  @@unique([tournamentId, userId])
}

// ─────────────────────────────────────────────────────────────
// RONDES ET MATCHS
// ─────────────────────────────────────────────────────────────

model Round {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int         // numéro de la ronde (1, 2, 3...)
  status       RoundStatus @default(PENDING)

  matches Match[]

  createdAt DateTime @default(now())

  @@unique([tournamentId, number])
}

enum RoundStatus {
  PENDING     // pas encore commencée
  IN_PROGRESS // en cours
  COMPLETED   // terminée
}

model Match {
  id      String @id @default(cuid())
  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  player1Id String
  player1   TournamentPlayer  @relation("Player1", fields: [player1Id], references: [id])
  player2Id String?           // null = BYE (nombre impair de joueurs)
  player2   TournamentPlayer? @relation("Player2", fields: [player2Id], references: [id])

  player1Score Int?
  player2Score Int?
  winnerId     String? // id du TournamentPlayer gagnant, null = draw

  status MatchStatus @default(PENDING)

  table Int?    // numéro de table physique
  notes String? // notes arbitre

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MatchStatus {
  PENDING     // pas encore joué
  IN_PROGRESS // en cours
  COMPLETED   // résultat saisi
  BYE         // joueur exempt (adversaire absent ou nombre impair)
}
